# Copy this file to .env.local and fill in the values for local development.
# For production, set these in your hosting provider's dashboard instead.
#
# Keys, secrets, and tokens don't belong in this file. See
# content/docs/doc-updates.mdx for the secrets the doc update automation needs,
# and set them in the Vercel dashboard.

# Name of the product these docs describe, shown in the top bar and page
# titles. Falls back to MyProduct if unset.
PRODUCT_NAME=MyProduct

# Public URL of the deployed site. Used for canonical links, Open Graph tags,
# sitemap.xml, robots.txt, and llms.txt.
SITE_URL=http://localhost:3000

# Subpath the site is served from, such as /repo-name. Leave empty for
# root-domain hosts like Vercel.
BASE_PATH=

# Doc update automation. Set to true to turn it on.
DOC_UPDATE_AUTOMATION_ENABLED=false

# GitHub repository that the automation watches.
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Paths in that repository that the automation watches.
WATCHED_DOCS_FOLDER=content/docs
WATCHED_NAV_CONFIG_PATH=content/nav.config.ts
